{
  "entities": {
    "CatalogObject": {
      "title": "CatalogObject",
      "description": "An object or concept in the arcane catalog.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" },
        "dateAdded": { "type": "number" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "location": { "type": "string" },
        "coordinates": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "notes": { "type": "string" },
        "customFields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": { "type": "string" },
              "value": { "type": "string" }
            }
          }
        },
        "bearer": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "rank": { "type": "string" }
          }
        },
        "threatGrade": { "type": "string" },
        "powerLevel": { "type": "number" }
      },
      "required": ["id", "title", "description", "dateAdded", "tags"]
    },
    "DisasterEvent": {
      "title": "DisasterEvent",
      "description": "Arcane news signals and disaster reports.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "location": { "type": "string" },
        "type": { "type": "string" },
        "severity": { "type": "string" },
        "description": { "type": "string" },
        "timestamp": { "type": "string" },
        "createdAt": { "type": "number" },
        "fullArticle": { "type": "string" }
      },
      "required": ["id", "location", "type", "severity", "description", "timestamp"]
    }
  },
  "firestore": {
    "catalog": {
      "schema": { "$ref": "#/entities/CatalogObject" },
      "description": "Collection of arcane objects and concepts."
    },
    "signals": {
      "schema": { "$ref": "#/entities/DisasterEvent" },
      "description": "Collection of global disaster signals and news articles."
    }
  }
}
